        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
        "\n",
        "print(\"Libraries imported successfully!\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "dates = pd.date_range(start=\"2021-01-01\", end=\"2025-12-01\", freq=\"MS\")\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "months = np.arange(len(dates))\n",
        "\n",
        "# Generate realistic sales with trend + seasonal variation + small noise\n",
        "sales = (\n",
        "    50000\n",
        "    + months * 650\n",
        "    + 7000 * np.sin(2 * np.pi * months / 12)\n",
        "    + np.random.normal(0, 2500, len(months))\n",
        ")\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    \"Date\": dates,\n",
        "    \"Sales\": sales.round(0).astype(int)\n",
        "})\n",
        "\n",
        "print(\"Dataset created successfully!\")\n",
        "print(\"Number of records:\", len(df))\n",
        "\n",
        "df.head()"
